# Environment for the API (apps/api). On a host, set these as service variables. ASP.NET Core also accepts the double-underscore
# form for nested settings (Site__Url means Site:Url).

# --- Database (one of these) ---
# Preferred on hosting platforms (Railway, Render, Fly, Heroku style):
DATABASE_URL=postgres://user:password@host:5432/ssrf
# Or the explicit Npgsql form:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=ssrf;Username=postgres;Password=change-me
# Or the separate variables: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD

# --- Required ---
# The first account registered with this address becomes the Administrator.
Bootstrap__AdminEmail=sagatsingh.org@gmail.com
# Public address of the site; used in password-reset links.
Site__Url=https://sagatsingh.org
ASPNETCORE_ENVIRONMENT=Production

# --- Behind a proxy / platform ---
# Trust X-Forwarded-For so rate limiting sees the real visitor address.
Proxy__TrustForwardedHeaders=true
# The port to listen on. Most hosts set it; the image default is 8080.
# PORT=8080

# --- Files ---
# Uploaded files are stored on disk here. Mount a persistent volume at this path.
Storage__LocalPath=/data/storage
# Apply database migrations when the API starts.
Database__MigrateOnStartup=true

# --- Password-reset email (optional; without SMTP_HOST the site says reset by email is not set up) ---
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@sagatsingh.org

# --- Limits ---
# Sign-in/register/reset attempts allowed per visitor per minute.
# RateLimit__AuthPerMinute=20
