# Copy to .env (never commit .env). Generate a long random password; do not reuse one from elsewhere.
POSTGRES_PASSWORD=
# The first account registered with this address becomes the Administrator. Everyone else starts as Member.
ADMIN_EMAIL=
# Public URL of the site, used for canonical links, sitemap and citations.
SITE_URL=https://sagatsingh.org

# Password-reset email (SMTP). Leave SMTP_HOST empty and the site says reset-by-email is not set up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sagatsingh.org
